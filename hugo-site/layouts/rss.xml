{{- $pages := where (where site.RegularPages "Section" "in" (slice "publication" "talk")) "Params.private" "!=" true -}}
{{- if not .IsHome }}{{ $pages = where $pages "Section" .Section }}{{ end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} | {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.owner.name }}, {{ site.Params.owner.title }}, {{ site.Params.owner.institution }}</description>
    <language>{{ site.LanguageCode }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{- range first 50 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ or .Params.abstract .Params.publication .Params.event "" | plainify | htmlUnescape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
